<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:id="@+id/settings_toolbar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/settings_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back_to_games"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_left" />

            <TextView
                android:id="@+id/settings_title"
                style="@style/GameCenter.Text.Title"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="@string/settings_title" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/settings_intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <TextView
                style="@style/GameCenter.Text.Section"
                android:layout_width="match_parent"
                android:layout_height="33dp"
                android:gravity="center_vertical"
                android:text="@string/settings_intro_heading" />

            <TextView
                android:id="@+id/settings_intro_subtitle"
                style="@style/GameCenter.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:gravity="top"
                android:text="@string/settings_intro_subtitle" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/settings_games"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <TextView
                style="@style/GameCenter.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:gravity="center_vertical"
                android:text="@string/settings_section" />

            <LinearLayout
                android:id="@+id/server_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="116dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_pistachio"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/GameCenter.Text.CardDescription"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:text="@string/settings_note_title"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                style="@style/GameCenter.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:gravity="top"
                android:text="@string/settings_note_body" />
        </LinearLayout>

        <TextView
            android:id="@+id/settings_footer"
            style="@style/GameCenter.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/settings_footer" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
