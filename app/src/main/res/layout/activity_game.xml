<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/game_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:id="@+id/game_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="0dp">

        <LinearLayout
            android:id="@+id/game_toolbar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/game_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back_to_games"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_left" />

            <TextView
                android:id="@+id/game_title"
                style="@style/GameCenter.Text.Title"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:gravity="center_vertical" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/game_stage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <WebView
                android:id="@+id/web_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/pistachio"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/loading_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="96dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_pistachio">

                        <ImageView
                            android:id="@+id/loading_icon"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_loader_circle" />
                    </FrameLayout>

                    <TextView
                        style="@style/GameCenter.Text.Section"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:layout_marginTop="20dp"
                        android:gravity="center"
                        android:text="@string/loading_heading" />

                    <TextView
                        style="@style/GameCenter.Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="22dp"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:text="@string/loading_subtitle" />

                    <ProgressBar
                        android:id="@+id/loading_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="200dp"
                        android:layout_height="4dp"
                        android:layout_marginTop="20dp"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/progress_loading" />
                </LinearLayout>

                <TextView
                    style="@style/GameCenter.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="24dp"
                    android:gravity="center"
                    android:text="@string/loading_brand" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/error_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="112dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_peach">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_wifi_off" />
                    </FrameLayout>

                    <TextView
                        style="@style/GameCenter.Text.Section"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:layout_marginTop="20dp"
                        android:gravity="center"
                        android:text="@string/load_error" />

                    <TextView
                        style="@style/GameCenter.Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:text="@string/load_error_hint" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="24dp"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/retry"
                        style="@style/GameCenter.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="@string/retry"
                        android:textAppearance="@style/GameCenter.Text.Button" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/error_return"
                        style="@style/GameCenter.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:text="@string/back_to_games"
                        android:textAppearance="@style/GameCenter.Text.Button" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
